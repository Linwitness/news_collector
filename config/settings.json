{
  "active_llm": "deepseek",
  "llm_providers": {
    "anthropic": {
      "api_key_env": "ANTHROPIC_API_KEY",
      "base_url": null,
      "model": "claude-sonnet-4-6",
      "translation_model": "claude-haiku-4-5-20251001"
    },
    "deepseek": {
      "_comment": "deepseek-flash is the API id for DeepSeek-V4.1-Flash",
      "api_key_env": "GENERAL_API_KEY",
      "base_url": "https://api.deepseek.com/anthropic",
      "model": "deepseek-flash",
      "translation_model": "deepseek-flash",
      "thinking": false,
      "max_tokens": 16000,
      "translation_max_tokens": 20000,
      "weekly": {
        "_comment": "Thinking on for the weekly synthesis: in testing it was better grounded (thinking off invented an event and graded last week's predictions too generously)",
        "thinking": {"type": "enabled"},
        "max_tokens": 32000
      },
      "papers": {
        "_comment": "Thinking on for the weekly paper analysis (same reasoning as weekly)",
        "thinking": {"type": "enabled"},
        "max_tokens": 32000
      }
    }
  },
  "output_dir": "output",
  "max_articles_per_topic": 40,
  "hours_lookback": 24,
  "alert_lookback_hours": 2,
  "alert_score_threshold": 2,
  "alert_state_path": "output/state/seen_urls.json",
  "alert_seen_ttl_days": 7,
  "papers": {
    "lookback_days": 7,
    "candidates_per_topic": 150,
    "max_papers_per_topic": 50,
    "highlights_per_topic": 5,
    "seen_ttl_days": 90,
    "state_path": "output/state/seen_papers.json"
  }
}
