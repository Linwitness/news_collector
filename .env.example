# Copy this file to .env and fill in your real values.
# .env is gitignored and will never be committed.

ANTHROPIC_API_KEY=your_anthropic_api_key_here
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
# Optional: own bots for the daily/weekly digests and the paper digest (see README "Telegram bots").
# Unset = sent through the main bot above.
# TELEGRAM_BOT_TOKEN_NEWS=
# TELEGRAM_BOT_TOKEN_PAPERS=

# --- General / future API keys ---
# DeepSeek API key — used when "active_llm" is "deepseek" in config/settings.json.
GENERAL_API_KEY=your_general_api_key_here
